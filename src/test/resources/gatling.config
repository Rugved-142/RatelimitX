gatling {
  core {
    encoding = "utf-8"
  }

  data {
    # console for live progress, file for the simulation.log the report is built from.
    writers = [console, file]
  }

  charting {
    indicators {
      lowerBound = 50
      higherBound = 100
      percentile1 = 50
      percentile2 = 75
      percentile3 = 95
      percentile4 = 99
    }
  }
}
