# Copy to .env and replace every value below before starting the stack.
#   cp .env.example .env
# .env is gitignored. docker compose fails fast if any of these is missing.

# Database
POSTGRES_DB=ratelimitx
POSTGRES_USER=ratelimitx
POSTGRES_PASSWORD=replace_me_postgres_password

# Application datasource. The password must match POSTGRES_PASSWORD.
# Note: postgres only applies POSTGRES_PASSWORD when it initialises an empty data directory.
# If you change it after a first run, recreate the volume: docker compose down -v
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ratelimitx
SPRING_DATASOURCE_USERNAME=ratelimitx
SPRING_DATASOURCE_PASSWORD=replace_me_postgres_password

# JWT signing key. Minimum 32 bytes; the application refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace_me_with_openssl_rand_base64_48_output_at_least_32_bytes

# Grafana admin login. There is no admin/admin fallback.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_me_grafana_password

# Analytics feed (optional). Both default to false; the stack behaves as it always has while
# they are. Start the broker with: docker compose --profile kafka up -d
RATELIMIT_EVENTS_ENABLED=false
RATELIMIT_ANALYTICS_ENABLED=false
